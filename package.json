    "eslint-config-next": "14.2.35",
    "express": "^5.2.1",
    "express-rate-limit": "8.7.1",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "next": "14.2.35",
    "next-auth": "^4.24.15",
    "node-cron": "^4.4.1",
    "nodemailer": "^9.0.5",
    "playwright": "^1.61.0",
