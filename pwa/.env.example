# Browser-safe backend address. Requests go through the same-origin /api/backend proxy.
NEXT_PUBLIC_API_URL=https://pricecheck-backend-7tkh.onrender.com
PRICECHECK_BACKEND_URL=https://pricecheck-backend-7tkh.onrender.com
NEXT_PUBLIC_SITE_URL=
NEXTAUTH_URL=
# Generate securely in hosting settings; never commit actual values.
NEXTAUTH_SECRET=
# Must match backend USER_SYNC_JWT_SECRET. Authentication fails closed if not configured.
USER_SYNC_JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_SENTRY_DSN=
# Explicit plain-HTTP local-only cookie mode, never enable on public HTTPS.
AUTH_TRUST_LOCAL_HTTP=false

# Optional centralized NextAuth in the existing Render PWA; same-origin proxy
# forwards only allowlisted account endpoints. No platform secrets are reused.
TROLLEYWISE_AUTH_SERVER_URL=https://pricecheck-backend-7tkh.onrender.com
APP_SESSION_SECRET=
TROLLEYWISE_WEB_URL=https://pricecheck-7dykljea.manus.space
